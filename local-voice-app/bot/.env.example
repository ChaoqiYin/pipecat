# Backend configuration for both local-voice-app entry points.
# Copy values into the repository root .env, not this directory.

# ElevenLabs speech synthesis is used when no VOLCENGINE_TTS_* setting is configured.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# DeepSeek language model.
DEEPSEEK_API_KEY=

# Volcengine credentials are shared by recognition and synthesis. This key selects
# Volcengine recognition; add VOLCENGINE_TTS_SPEAKER to select Volcengine synthesis.
VOLCENGINE_API_KEY=

# Optional JSON: enable_itn, enable_punc, and provider corpus_context.
# Omitted flags use provider defaults. Second-pass recognition is always enabled.
VOLCENGINE_STT_OPTIONS={}
# VOLCENGINE_STT_OPTIONS='{"enable_itn":true,"enable_punc":true,"corpus_context":{"hotwords":[{"word":"Pipecat"}]}}'

# No VOLCENGINE_TTS_* setting uses ElevenLabs synthesis. Configure the speaker to
# use Volcengine synthesis. The model version is fixed in code.
VOLCENGINE_TTS_SPEAKER=

# Optional JSON: audio_format, sample_rate, and provider additions.
# The speaker is configured above, not here.
VOLCENGINE_TTS_OPTIONS={}
# VOLCENGINE_TTS_OPTIONS='{"audio_format":"pcm","sample_rate":24000}'

# The knowledge base is the llm_wiki desktop application's local HTTP API.
# Setting WIKI_TOKEN to that API's token enables it; with no value, set or not,
# the session runs with no knowledge base tool. The API listens on loopback only,
# so the bot, the browser client and the desktop application run on the same machine.
# WIKI_API_BASE_URL overrides the API root, which defaults to
# http://127.0.0.1:19828.
#WIKI_TOKEN=your_wiki_api_token
#WIKI_API_BASE_URL=http://127.0.0.1:19828
